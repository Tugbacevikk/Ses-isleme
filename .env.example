# ==============================================================================
# SES ANALİZİ PLATFORMU - ÖRNEK ORTAM DEĞİŞKENLERİ (.env.example)
# ==============================================================================

# 1. Veritabanı Yapılandırması (SQLite / PostgreSQL)
DATABASE_URL=sqlite:///storage/dev_database.db

# 2. Asenkron Görev Kuyruğu (Redis URL)
REDIS_URL=redis://localhost:6379/0

# 3. HuggingFace Access Token (PyAnnote 3.1 SOTA Diarization)
HF_TOKEN=your_huggingface_token_here
