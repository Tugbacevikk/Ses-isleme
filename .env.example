# ==============================================================================
# SES ANALİZİ PLATFORMU - ÖRNEK ORTAM DEĞİŞKENLERİ (.env.example)
# ==============================================================================

# 1. API Güvenliği (X-API-Key Başlık Doğrulaması & Webhook HMAC İmzası)
API_KEY=my_secure_api_key_12345
WEBHOOK_SECRET=my_webhook_secret_key_67890

# 2. Görev Yürütme ve Mesajlaşma Kuyruğu (Redis Streams)
# USE_REDIS_STREAM=true ise istekler Redis Streams tüketici grubuna aktarılır (Bağımsız Sunucular & Yüksek Ölçek).
# USE_REDIS_STREAM=false ise FastAPI içi BackgroundTasks kullanılır (Tek Süreç).
USE_REDIS_STREAM=true
REDIS_URL=redis://localhost:6379/0

# 3. Ses Dosyası Depolama Yapılandırması
# STORAGE_TYPE seçenekleri:
# - 'disk': Paylaşımlı volume / tek sunucu / Docker Compose (STORAGE_DIR=storage/raw)
# - 's3': AWS S3 veya MinIO nesne depolama (Çoklu sunucu / bulut altyapısı)
# - 'memory': Yalnızca tek süreçli test/CLI/BackgroundTasks (USE_REDIS_STREAM=true ile KULLANILAMAZ)
STORAGE_TYPE=disk
STORAGE_DIR=storage/raw
MEMORY_STORAGE_MAX_BYTES=536870912

# 4. Veritabanı Yapılandırması (PostgreSQL / SQLite)
# ALLOW_SQLITE_FALLBACK=false (Varsayılan): Postgres bağlantı hatasında konteynerin durmasını sağlar (Loud-Fail / Split-Brain koruması).
# ALLOW_SQLITE_FALLBACK=true: Postgres bağlantısı koptuğunda geçici olarak yerel SQLite dosyasına düşer.
DATABASE_URL=sqlite:///storage/dev_database.db
ALLOW_SQLITE_FALLBACK=false

# 5. Çevrimdışı Yapay Zeka Model Yapılandırması (%100 Token-Free & Yerel)
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# 6. Yapay Zeka Model Yapılandırması
WHISPER_MODEL_SIZE=small
DIARIZATION_STEP_SEC=0.5
DIARIZATION_THRESHOLD=0.42
MAX_SILENCE_THRESHOLD=1.5
ENABLE_DENOISER=false

# 7. SemanticRefiner & Yerel LLM Entegrasyonu (Opsiyonel)
DOMAIN_MODE=
USE_LLM=false
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3.2

# 8. S3 / Cloud Depolama Detayları (STORAGE_TYPE=s3 durumunda)
# S3_BUCKET_NAME=ses-analizi-storage
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_REGION=us-east-1
# S3_ENDPOINT_URL=http://localhost:9000
