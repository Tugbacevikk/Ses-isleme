# ==============================================================================
# SES ANALİZİ PLATFORMU - ÖRNEK ORTAM DEĞİŞKENLERİ (.env.example)
# ==============================================================================

# 1. Veritabanı Yapılandırması (SQLite / PostgreSQL)
DATABASE_URL=sqlite:///storage/dev_database.db

# 2. Asenkron Görev Kuyruğu (Redis URL)
REDIS_URL=redis://localhost:6379/0

# 3. HuggingFace Access Token (PyAnnote 3.1 SOTA Speaker Diarization)
# Token almak için: https://huggingface.co/settings/tokens (Read İzni)
# Gerekli 3 Model İzin Onayı:
#   1. https://huggingface.co/pyannote/speaker-diarization-3.1
#   2. https://huggingface.co/pyannote/speaker-diarization-community-1
#   3. https://huggingface.co/pyannote/segmentation-3.0
# NOT: HF_TOKEN girilmezse veya geçersizse sistem otomatik olarak 2. Kademe
# (SpeechBrain ECAPA-TDNN %100 Çevrimdışı) veya 3. Kademe (Local Spectral Cluster) motoruna düşer.
HF_TOKEN=your_huggingface_token_here

# 4. Yapay Zeka Model Yapılandırması
# Whisper Model Seçenekleri: tiny (Ultra Hızlı), small (Hızlı & Dengeli), medium (Blueprint Varsayılanı - Ağır)
WHISPER_MODEL_SIZE=small
MAX_SILENCE_THRESHOLD=1.5
ALLOW_MOCK_STT=false

# 5. SemanticRefiner & Yerel LLM Entegrasyonu (Opsiyonel)
# DOMAIN_MODE: 'call_center' veya boş (genel amaçlı domain-agnostic)
DOMAIN_MODE=
USE_LLM=false
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3.2

