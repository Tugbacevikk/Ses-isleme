# ==============================================================================
# SES ANALİZİ PLATFORMU - ÖRNEK ORTAM DEĞİŞKENLERİ (.env.example)
# ==============================================================================

# 1. API Güvenliği (X-API-Key Başlık Doğrulaması & Webhook HMAC İmzası)
# Boş bırakılırsa geliştirme modunda (Dev) yetkilendirme atlanır.
API_KEY=my_secure_api_key_12345
WEBHOOK_SECRET=my_webhook_secret_key_67890

# 2. Görev Yürütme ve Kuyruk Modu
# USE_REDIS_QUEUE=true ise istekler doğrudan Redis Queue (RQ) kuyruğuna aktarılır (Bağımsız Sunucular & Yüksek Ölçek).
# USE_CELERY=true ise Celery + Redis asenkron worker yapısı aktif olur.
# Her ikisi de false ise FastAPI içi BackgroundTasks kullanılır (Hafif/Tek Sunucu).
USE_REDIS_QUEUE=true
USE_CELERY=false
REDIS_URL=redis://localhost:6379/0

# 3. Veritabanı Yapılandırması (SQLite / PostgreSQL)
DATABASE_URL=sqlite:///storage/dev_database.db

# 4. Çevrimdışı Yapay Zeka Model Yapılandırması (%100 Token-Free & Yerel)
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# 5. Yapay Zeka Model Yapılandırması
# Whisper Model Seçenekleri: tiny (Ultra Hızlı), small (Hızlı & Dengeli), medium (Blueprint Varsayılanı - Ağır)
WHISPER_MODEL_SIZE=small
MAX_SILENCE_THRESHOLD=1.5
ALLOW_MOCK_STT=false

# 6. SemanticRefiner & Yerel LLM Entegrasyonu (Opsiyonel)
# DOMAIN_MODE: 'call_center' veya boş (genel amaçlı domain-agnostic)
DOMAIN_MODE=
USE_LLM=false
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3.2

# 7. S3 / Cloud Depolama Yapılandırması (Opsiyonel)
# Fiziksel ses dosyalarını S3 veya MinIO üzerinde saklamak isterseniz tanımlayın.
# S3_BUCKET_NAME=ses-analizi-storage
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_REGION=us-east-1
# S3_ENDPOINT_URL=http://localhost:9000


